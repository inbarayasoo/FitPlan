# Copy to `.env` (git-ignored) and fill in. Used by `docker compose` locally and
# as the reference for `fly secrets set` in production. The app also reads plain
# environment variables, so `export VAR=...` works too.

# --- required in production -------------------------------------------------
# A long random value. Generate one: openssl rand -hex 32
FITPLAN_JWT_SECRET=

# Brevo transactional-email API key (starts with xkeysib-). Without it, the
# six-digit verification code is written to the server log instead of emailed.
FITPLAN_BREVO_API_KEY=

# The "From" address for verification emails. Must be a Verified sender in Brevo.
FITPLAN_EMAIL_FROM=no-reply@fitplan.dev

# The public URL of the site, shown in the verification email body.
FITPLAN_PUBLIC_BASE_URL=http://localhost:8080

# --- optional ------------------------------------------------------------
# Google OAuth 2.0 web client id -> turns on "Sign in with Google". The site's
# URL must be an authorized JavaScript origin in Google Cloud. Not a secret
# (the browser sends it), but keep it out of git.
FITPLAN_GOOGLE_CLIENT_ID=

FITPLAN_LOG_LEVEL=info
